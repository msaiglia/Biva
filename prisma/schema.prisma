// Schema Prisma per Neon (Postgres serverless)
// Fase 1 (MVP): Patient, Measurement, ReferencePopulation, User
// Le fasi successive aggiungeranno audit log e ruoli granulari.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connection string Neon (pooled)
  directUrl = env("DIRECT_URL") // connection string Neon diretta, per le migrazioni
}

enum Sex {
  M
  F
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         String    @default("operatore") // operatore | admin
  createdAt    DateTime  @default(now())
  patients     Patient[]
}

model Patient {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  sex          Sex
  birthDate    DateTime
  clinicalNote String? // es. categoria clinica: IRC, oncologico, atleta, anziano...
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime      @default(now())
  measurements Measurement[]

  @@index([lastName, firstName])
}

model Measurement {
  id                 String             @id @default(cuid())
  patient            Patient            @relation(fields: [patientId], references: [id])
  patientId          String
  measuredAt         DateTime           @default(now())
  heightCm           Float
  weightKg           Float?
  resistanceOhm      Float // R, dal dispositivo
  reactanceOhm       Float // Xc, dal dispositivo
  phaseAngleDevice   Float? // PA letto direttamente dal dispositivo
  // Circonferenze corporee, opzionali — necessarie solo per la BIVA specifica
  armCircumferenceCm   Float?
  waistCircumferenceCm Float?
  calfCircumferenceCm  Float?
  // Campi derivati BIVA classica, calcolati dal motore e salvati per audit/storico:
  rH                 Float // R/H, Ohm/m
  xcH                Float // Xc/H, Ohm/m
  phaseAngleComputed Float // arctan(Xc/R) * 180/pi
  referencePopulation ReferencePopulation @relation(fields: [referencePopulationId], references: [id])
  referencePopulationId String
  bivaPattern        String? // risultato della classificazione a 7 zone (classica)
  // Campi derivati BIVA specifica, opzionali (solo se le circonferenze sono presenti):
  rSp                Float? // Rsp, Ohm*cm
  xcSp               Float? // Xcsp, Ohm*cm
  bivaPatternSpecific String?
  notes              String?
  createdAt          DateTime           @default(now())

  @@index([patientId, measuredAt])
}

/// Una riga = un'ellisse di riferimento, da tabelle pubblicate e verificate.
/// meanX/sdX/meanY/sdY sono generici: rappresentano R/H,Xc/H (metodo
/// "classic") oppure Rsp,Xcsp (metodo "specific") — stessa geometria
/// statistica, variabili diverse. Nessun valore è precaricato di default:
/// va inserito da fonte citata (vedi prisma/seed.ts).
model ReferencePopulation {
  id               String        @id @default(cuid())
  code             String        @unique // es. "PICCOLI_1995_M"
  label            String // es. "Adulti generali maschi (Piccoli 1995)"
  sex              Sex
  method           String        @default("classic") // "classic" | "specific"
  category         String // generale | anziani | pediatrico | obesita | IRC-dialisi | oncologia | atleti
  n                Int // numerosità campionaria dello studio originale
  meanX            Float // media R/H (Ohm/m) o Rsp (Ohm*cm) a seconda di method
  sdX              Float
  meanY            Float // media Xc/H (Ohm/m) o Xcsp (Ohm*cm) a seconda di method
  sdY              Float
  correlationR     Float
  ageMin           Int?
  ageMax           Int?
  sourceCitation   String // citazione completa, es. "Piccoli A et al. Am J Clin Nutr. 1995;61:269-270"
  sourceDOI        String?
  pubmedVerified   Boolean       @default(false) // true solo se verificato con PMID
  pubmedId         String? // PMID, se disponibile
  addedAt          DateTime      @default(now())
  measurements     Measurement[]
}
